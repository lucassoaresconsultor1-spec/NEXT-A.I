# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
# Runtime connection: a role WITHOUT superuser/BYPASSRLS so row-level security applies.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
# Optional: schema owner used only by db:migrate (takes precedence over the two above).
DATABASE_MIGRATION_URL=
# At least 32 random characters, e.g. `openssl rand -base64 48`. Required for login/sign-up.
AUTH_SECRET=
# Self-service company sign-up (true/false). Defaults to true.
ALLOW_SIGNUP=true
LOG_LEVEL=info
